# O include do pest-plugin-phpstan vale mesmo com `tests` fora dos paths: ele
# tipa `expect()`, o `$this` das closures de teste e o higher-order testing, e e
# pre-requisito para o dia em que `tests` entrar. Sem `phpstan/extension-installer`
# no projeto, o include e manual.
includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    level: 7

    ignoreErrors:
        # `simpleLightbox()` é MACRO: o solution-forest/filament-simplelightbox o registra em
        # `ImageColumn::macro(...)` dentro do `boot(Panel $panel)` do plugin
        # (SimpleLightBoxPlugin.php:24-104). Macro é resolvido em runtime por
        # `Macroable::__call()`, e o boot do painel só acontece dentro de um request de painel
        # (middleware `SetUpPanel`) — nunca durante a análise. Nenhuma análise estática o enxerga.
        #
        # Tentado e descartado ANTES desta exceção:
        #   - `stubFiles`: PHPStan usa stub para SOBRESCREVER assinatura de método existente,
        #     não para ACRESCENTAR método a uma classe de vendor. Sem efeito, verificado.
        #   - replicar as 5 linhas do macro com a API pública da coluna: acopla o kit ao
        #     miolo do vendor e quebra calado no primeiro upgrade que mudar o gatilho.
        #
        # A cobertura de verdade deste ponto é o teste, não o analisador:
        # `tests/Kit/LightboxEmTabelaTest.php` assere o gatilho `SimpleLightBox.open` no HTML e
        # a presença do plugin nos três painéis. Se o macro sumir num upgrade, ele fica
        # vermelho — que é mais do que o PHPStan faria aqui de qualquer forma.
        -
            message: '#Call to an undefined method .*::simpleLightbox\(\)#'
            paths:
                - app/Filament/*/Resources/**

        # `customMyProfilePage()` do filament-breezy tem a ANOTAÇÃO errada, e ela é
        # insatisfazível: `@param class-string<Pages\MyProfilePage> $class`
        # (vendor/jeffgreco13/filament-breezy/src/Concerns/Plugin/HasMyProfile.php:29-33). O
        # prefixo `Pages\` é resolvido relativo ao namespace do trait, então o tipo pedido é
        # `Jeffgreco13\FilamentBreezy\Concerns\Plugin\Pages\MyProfilePage` — uma classe que NÃO
        # EXISTE. O `use Jeffgreco13\FilamentBreezy\Pages\MyProfilePage;` no topo do arquivo (`:10`)
        # mostra qual era a intenção, e é dela que `App\Filament\Pages\MyProfilePage` herda.
        #
        # Nenhum argumento pode satisfazer o tipo declarado. Tentado e descartado antes desta
        # exceção:
        #   - `stubFiles`: sobrescreveria a assinatura, mas o método vem de um TRAIT usado por
        #     `BreezyCore`, e o stub teria de replicar o trait inteiro — que quebra calado no
        #     primeiro upgrade que acrescentar um método a ele.
        #   - herdar da classe do namespace errado: ela não existe.
        #
        # A cobertura de verdade é o teste: `tests/Kit/PermissoesDeTelasTest.php` assere 403 em
        # `/{painel}/meu-perfil` com `View:MyProfilePage` revogada, nos painéis `infra` e `admin`.
        # Se o registro parar de valer, ele fica vermelho.
        -
            message: '#customMyProfilePage\(\) expects class-string<Jeffgreco13\\FilamentBreezy\\Concerns\\Plugin\\Pages\\MyProfilePage>#'
            paths:
                - app/Providers/Filament/AdminPanelProvider.php
                - app/Providers/Filament/AppPanelProvider.php
                - app/Providers/Filament/InfraPanelProvider.php

    # `tests` NAO esta nos paths, e a ausencia e medida.
    #
    # Com o `pest-plugin-phpstan` incluido acima: 117 erros em 26 dos 62 arquivos.
    # Sem ele: 566. O plugin nao adiciona ruido — ele REMOVE 449 falsos positivos,
    # e essa diferenca e o que torna `tests` analisavel um dia.
    #
    # Os 117 que sobram nao sao defeito: sao level 7 vendo codigo de teste pela
    # primeira vez, e tres padroes respondem por 33 deles — `artisan()` devolve
    # `PendingCommand|int`, spy do Mockery em `LoggerInterface`, e fake de Mail em
    # `TransportInterface`.
    #
    # Nenhuma das regras PROPRIAS do plugin acusou nada: zero expectation
    # impossivel, zero descricao de teste duplicada, zero `covers()` com classe
    # inexistente. O ganho de incluir `tests` e prevencao, nao um lote de defeito
    # esperando.
    #
    # `types:check` e gate dentro do `composer test`. Incluir `tests` sem pagar a
    # triagem deixa o gate vermelho, e gate vermelho por ruido ensina a ignorar
    # gate. Ver wikis/qualidade-de-codigo.md.
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes

    excludePaths:
        # Migrations publicadas por pacotes: são stubs de vendor, não código do projeto.
        - database/migrations/*_create_health_tables.php
        - database/migrations/*_create_breezy_sessions_table.php
        - database/migrations/*_create_pulse_tables.php
