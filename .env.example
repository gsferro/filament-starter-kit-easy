APP_NAME="Starter Kit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite por padrão: o create-project instala sem depender de serviço externo.
# Para Postgres via Docker, copie as variáveis de .env.docker por cima destas.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=starter_kit
# DB_USERNAME=starter_kit
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# reverb liga o tempo real (sininho sem polling) — exige o container/processo Reverb.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Model caching (mike-bronner) — só com Redis; ver .env.docker.
MODEL_CACHE_ENABLED=false
# MODEL_CACHE_STORE=model-cache

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Identidade dos painéis ------------------------------------------------
# Cor primária dos três painéis. Nome de uma cor da paleta do Filament: Amber,
# Blue, Cyan, Emerald, Fuchsia, Indigo, Lime, Orange, Pink, Purple, Red, Rose,
# Sky, Slate, Teal, Violet. Vazio = o padrão do Filament.
# A cor de uma organização (multi-tenancy) vence esta dentro de /app/{slug}.
KIT_COR_PRIMARIA=

# Cor de marca livre, em hexadecimal (#rgb ou #rrggbb). VENCE a KIT_COR_PRIMARIA
# quando as duas estão preenchidas. Valor fora do formato é ignorado e a cor cai
# para a lista acima, em vez de derrubar o painel.
KIT_COR_PRIMARIA_HEX=

# --- Defaults de toda tabela do projeto ------------------------------------
# Editáveis em /admin/configuracoes-do-kit, que é o caminho normal. Estas chaves
# são a semente e o plano B: o valor gravado no banco vence em tempo de execução.
# Vazio cai no default (nunca em 0/false) — ver o bloco em config/kit.php.
# KIT_TABELA_PAGINACAO=10
# KIT_TABELA_LISTRADA=true
# KIT_TABELA_PERSISTIR_FILTROS=true
# KIT_TABELA_COLUNAS_REDIMENSIONAVEIS=true

# --- Teto de tamanho de todo upload ----------------------------------------
# Em MEGABYTES. Vale para a logo, o favicon e a arte do login
# (/admin/configuracoes-do-kit), a logo da organização (/admin/organizacoes), os
# anexos de Projeto e o upload temporário do Livewire. Vazio, 0 ou ausente = 10.
# Acima de 52 MB, mude também docker/php/uploads.ini (upload_max_filesize e
# post_max_size) e docker/nginx/nginx.conf (client_max_body_size). Fora do Docker
# do kit, o PHP costuma vir com upload_max_filesize=2M, que passa a ser o teto
# real. SVG é recusado em todo campo, independentemente do tamanho.
# KIT_UPLOAD_MAXIMO_MB=10

# Cache das configurações lidas do banco (spatie/laravel-settings). Desligado no
# kit: com ele ligado, gravar pela tela exige `php artisan settings:clear-cache`.
# SETTINGS_CACHE_ENABLED=false

# --- Usuário inicial -------------------------------------------------------
# Criado pelo UsuarioAdminSeeder com o papel master_global, na instalação.
# Troque a senha antes de expor o ambiente.
# KIT_ADMIN_NAME=Administrador
KIT_ADMIN_EMAIL=admin@example.com
KIT_ADMIN_PASSWORD=password

# --- Multi-organização (multi-tenancy) -------------------------------------
# Ligue com `php artisan kit:tenancy` — o comando escreve esta chave. Editar à
# mão num projeto já migrado deixa config e schema incoerentes. Na instalação é
# o `kit:install` que liga, antes do primeiro migrate e sem recriar o banco.
KIT_TENANCY=false

# Como o usuário chama cada organização. O CÓDIGO segue o vocabulário do
# Filament (model Tenant, tabela tenants); só o rótulo muda aqui.
# KIT_TENANCY_LABEL=Organização
# KIT_TENANCY_LABEL_PLURAL=Organizações
# KIT_TENANCY_SLUG=organizacoes

# Cenário de demonstração (`php artisan kit:tenancy --demo`), que é quem escreve
# esta chave. É ela que faz o resource de exemplo "Projetos" aparecer no /app —
# sem ela o painel de negócio nasce vazio, como deve. Só vale com KIT_TENANCY=true.
KIT_DEMO=false

# Hub de navegação em cards nos painéis /admin e /app: uma grade de cartões com
# os destinos do painel, em vez da árvore da barra lateral. Desligado porque o
# kit inicial não precisa. O /infra tem hub independente desta chave.
KIT_HUB=false

# Repositório consultado pelo `php artisan kit:update` (o `--repo=` vence). Vazio
# cai no repositório oficial do kit. Troque só para atualizar a partir de um fork.
# KIT_REPOSITORY=https://github.com/gsferro/filament-starter-kit-easy.git

# --- Registro aberto no /app -----------------------------------------------
# Porta PÚBLICA que cria conta. Com `false` (o default) o /app/register só
# responde a quem traz token de convite válido — o comportamento de sempre.
# Quem se registra por aqui recebe UM papel (panel_user) e nada além dele.
KIT_REGISTRO=false

# O cadastro nasce pendente e não entra em painel nenhum até alguém aprovar na
# tela de usuários. Com `false`, entra na hora.
KIT_REGISTRO_APROVACAO_MANUAL=false

# Exige e-mail validado no /app: liga a tela de confirmação e o middleware.
# Vale para TODO usuário do painel, não só os novos — quem estiver sem
# email_verified_at é barrado. Quem vem de convite nunca é afetado.
KIT_REGISTRO_VERIFICAR_EMAIL=false

# --- Login social (laravel/socialite) --------------------------------------
# QUATRO provedores, cada um com o seu interruptor, todos DESLIGADOS por default.
# Ligar um não liga os outros, e desligar um não derruba os outros.
#
# Ligar aqui NÃO põe o botão no ar sozinho: as três chaves daquele provedor
# também precisam estar preenchidas — são duas condições, porque falham por
# motivos diferentes (interruptor desligado é escolha, credencial vazia é
# descuido). E este arquivo só SEMEIA: com o kit já instalado, a tabela
# `settings` vence o .env em todo request. Ligue pela tela
# /admin/configuracoes-do-kit > Login, ou `kit:install --force` (recria o banco). Com o interruptor de um provedor desligado, as rotas
# /auth/{provedor}/* respondem 404 — e só as dele: esconder o botão não basta,
# a URL é pública.
#
# Provedor FORA da lista (facebook, discord, qualquer outro) responde 404 sem
# nem chegar ao controller: o parâmetro da rota é tipado como o enum
# App\Support\ProvedorSocial, e a lista branca é o próprio enum.
#
# O login social AUTENTICA quem já tem conta com aquele e-mail, verificado no
# provedor. Ele NÃO cria conta enquanto o registro aberto estiver desligado,
# porque o convite continua sendo a única porta de entrada do kit. Vale para os
# quatro.
#
# A coerção é FILTER_VALIDATE_BOOLEAN, então estes interruptores falham
# FECHADOS: `false`, `0`, `off`, `no`, vazio e qualquer valor irreconhecível os
# mantêm desligados. Só `true` e `1` ligam. É de propósito — eles abrem
# superfície pública de OAuth, e interruptor de segurança não liga por acidente.
#
# TODO *_CLIENT_SECRET é SEGREDO: não vai para log, nem para tela, nem para
# mensagem de erro, nem para o repositório. Gravado pela tela
# /admin/configuracoes-do-kit, ele fica CIFRADO no banco.
#
# Os READMEs têm, provedor por provedor, onde criar o app OAuth, qual URI de
# redirecionamento cadastrar e como o kit confirma que o e-mail está verificado
# em cada um — a resposta é diferente nos quatro.

# Google — console.cloud.google.com > APIs e serviços > Credenciais > ID do
# cliente OAuth. Redirecionamento: APP_URL + /auth/google/callback.
# Verificação: o campo `email_verified` do payload.
KIT_SOCIALITE_GOOGLE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub — github.com/settings/developers > OAuth Apps > New OAuth App.
# Redirecionamento: APP_URL + /auth/github/callback.
# Verificação: o Socialite consulta /user/emails e SOBRESCREVE o e-mail com a
# entrada primary + verified — ou com nada, se falhar. Então e-mail preenchido
# já significa verificado, e vazio cai na recusa por email_ausente. Isso depende
# do escopo `user:email`, que é o default do driver: acrescentar escopos na
# config é seguro (eles SOMAM), remover esse não é. Há caso de teste guardando.
KIT_SOCIALITE_GITHUB=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn — linkedin.com/developers > Create app > Products, e HABILITE o
# produto "Sign In with LinkedIn using OpenID Connect". O driver é
# `linkedin-openid` (não o `linkedin` legado, que não informa verificação
# nenhuma e cujos escopos a LinkedIn descontinuou).
# Redirecionamento: APP_URL + /auth/linkedin-openid/callback.
# Verificação: o campo `email_verified` do userinfo OpenID.
KIT_SOCIALITE_LINKEDIN=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# X (antigo Twitter) — developer.x.com > Projects & Apps > User authentication
# settings, tipo Web App com OAuth 2.0 e os escopos users.read e users.email.
# Redirecionamento: APP_URL + /auth/x/callback.
# Verificação: o X só devolve `confirmed_email`, ou seja, endereço que ele já
# confirmou — a PRESENÇA do e-mail é a prova. Sem o escopo users.email ele não
# devolve e-mail, e o kit recusa com o motivo `email_ausente`.
KIT_SOCIALITE_X=false
X_CLIENT_ID=
X_CLIENT_SECRET=

# Facebook e Discord NÃO têm chave aqui, e a ausência é decisão registrada:
# o Facebook não expõe sinal de e-mail verificado em nenhum dos seus dois
# caminhos, e o Discord não é driver do Socialite (viria de um pacote
# comunitário, ou seja, uma dependência nova). Os READMEs dizem o que faltaria
# para incluir cada um, e os ADR-04 e ADR-05 de
# wikis/specs/feat/mais-provedores-sociais/ dizem por que não incluímos.

# Rodapé da tela de login dos três painéis. Vazio (ou só espaços) = sem rodapé.
# TEXTO, não HTML: a tela de login é pública e não autenticada, e o valor sai
# escapado. Link no rodapé exigiria um campo estruturado, não HTML solto.
KIT_LOGIN_RODAPE=

# --- Convite de usuário ----------------------------------------------------
# Dias entre o envio do convite e a expiração do link. O envio exige
# MAIL_MAILER de verdade (o default `log` só escreve em storage/logs) e um
# worker de fila rodando, porque a notificação é enfileirável.
# Deixar VAZIO ou 0 aqui não desliga nada: cai no default de 7 dias. Convite de
# zero dia nasceria expirado, e o config/kit.php trata isso de propósito.
KIT_CONVITE_VALIDADE_DIAS=7

# Máximo de endereços por lote em "Convidar em massa". Com QUEUE_CONNECTION=sync
# cada e-mail é um handshake SMTP dentro do request, e cem encostam no
# max_execution_time. Subir daqui exige worker de fila rodando.
# Vazio ou 0 aqui nao desliga o limite: cai no default de 100.
KIT_CONVITE_LIMITE_LOTE=100

# Dias, contados do envio, em que cada lembrete do convite pendente é devido. O
# lembrete manda um SEGUNDO link, paralelo: o e-mail que a pessoa já tem continua
# valendo. Vazio desliga. Todo dia precisa ser MENOR que KIT_CONVITE_VALIDADE_DIAS,
# senão o convite expira antes e nenhum lembrete sai. Exige scheduler ativo (é
# `kit:convites-lembrar`, agendado em routes/console.php) e worker de fila.
KIT_CONVITE_LEMBRETES_DIAS=3,5

# --- Retenção das trilhas do /infra ---------------------------------------
# Quanto tempo o kit guarda o que ele GRAVA. Não é gosto: as duas tabelas
# crescem por evento e guardam dado sensível — stack trace pode conter
# parâmetro de request, e o corpo do e-mail do convite carrega o link de
# aceite. 14 dias acompanha o `days` da rotação de log.
#
# Quem aplica é o agendador (routes/console.php). Sem `schedule:work` ou o
# serviço `scheduler` do compose, o número aqui é só intenção declarada.
# Zero ou negativo desliga a poda — e aí a tabela cresce sem teto.
KIT_RETENCAO_EXCECOES_DIAS=14
KIT_RETENCAO_EMAILS_DIAS=14
KIT_RETENCAO_IMPORTACOES_DIAS=30
KIT_RETENCAO_EXPORTACOES_DIAS=30

# --- Mídia (spatie/laravel-medialibrary) ----------------------------------
# `public` é o default do pacote e serve para avatar e logo, que são imagens
# de identidade. NÃO serve para documento: o caminho é /storage/{id}/{arquivo}
# com ID sequencial, alcançável SEM SESSÃO e sem tenant — a multi-organização
# do Filament não chega ao sistema de arquivos.
#
# Para anexo que não seja imagem pública, troque para um disco privado e sirva
# por rota autorizada. Ver config/media-library.php e wikis/pacotes.md.
MEDIA_DISK=local

# --- Segurança dos painéis -----------------------------------------------
LOCKSCREEN_ENABLED=true
LOCKSCREEN_IDLE_TIMEOUT=1800
NEW_DEVICE_NOTIFICATION=false
COMMAND_CENTER_ENABLED=true
ONBOARDING_ENABLED=true

# --- IA (laravel/ai + ledger fomvasss) -------------------------------------
# Local por padrão (docker compose --profile ai up -d). Para SaaS, troque
# AI_PROVIDER (openai|anthropic|gemini...) e defina a API key correspondente.
AI_PROVIDER=llamacpp
# AI_AGENT_TIMEOUT=180
LLAMACPP_URL=http://localhost:8080/v1
LLAMACPP_MODEL=qwen2.5-7b-instruct
LLAMACPP_EMBED_URL=http://localhost:8081/v1
LLAMACPP_EMBED_MODEL=qwen3-embedding-0.6b
# OLLAMA_URL=http://localhost:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Ledger de execuções (ai_runs) — nunca guarda o prompt por padrão (LGPD).
AI_STORE_REQUEST=false
# AI_BUDGET_MENSAL_DEFAULT=100

# --- Tempo real (Reverb) — ver bloco completo em .env.docker ---------------
REVERB_APP_ID=starter-kit
REVERB_APP_KEY=starter-kit-key
REVERB_APP_SECRET=starter-kit-secret
REVERB_HOST=localhost
REVERB_PORT=8090
REVERB_SCHEME=http
REVERB_SERVER_PORT=8090
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
