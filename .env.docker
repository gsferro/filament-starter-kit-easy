# =============================================================================
# Cole/ajuste estas variáveis no seu .env quando usar as stacks do Docker.
# O kit instala com SQLite + filas/cache em database — este arquivo é o "upgrade".
# =============================================================================

APP_URL=http://localhost:8000

# --- Banco (container pgsql) -------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=starter_kit
DB_USERNAME=starter_kit
DB_PASSWORD=secret

# --- Cache (container redis — exclusivo de cache; filas ficam em database) ---
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Model caching (mike-bronner/laravel-model-caching) — só faz sentido com Redis.
MODEL_CACHE_ENABLED=true
MODEL_CACHE_STORE=model-cache

# --- Filas -------------------------------------------------------------------
QUEUE_CONNECTION=database

# --- E-mail (profile: mail → Mailpit em 1025/8025) ----------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=hello@example.com

# --- IA local (profile: ai → llama.cpp) ---------------------------------------
AI_PROVIDER=llamacpp
LLAMACPP_URL=http://localhost:8080/v1
LLAMACPP_MODEL=qwen2.5-7b-instruct
LLAMACPP_EMBED_URL=http://localhost:8081/v1
LLAMACPP_EMBED_MODEL=qwen3-embedding-0.6b

# --- Tempo real (profiles: app/realtime → Reverb em 8090) ---------------------
# Três pares com papéis distintos:
#   REVERB_*       = para onde o PHP manda o broadcast
#   VITE_REVERB_*  = para onde o BROWSER conecta (nunca nome de serviço Docker)
#   REVERB_SERVER_PORT = onde o processo reverb:start escuta
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=starter-kit
REVERB_APP_KEY=starter-kit-key
REVERB_APP_SECRET=starter-kit-secret
REVERB_HOST=localhost
REVERB_PORT=8090
REVERB_SCHEME=http
REVERB_SERVER_PORT=8090
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8090
VITE_REVERB_SCHEME=http
