  "cards": [
    {
      "dot": "cyan",
      "title": {
        "pt": "Nos três painéis",
        "en": "All three panels"
      },
      "items": [
        {
          "pt": "Os três providers ligam o 2FA do Breezy com a mesma linha, enableTwoFactorAuthentication(action: TelaDoisFatores::class), sem forçar o 2FA: quem não ativou entra sem desafio.",
          "en": "All three providers enable Breezy 2FA with the same line, enableTwoFactorAuthentication(action: TelaDoisFatores::class), without forcing 2FA: users who never enabled it enter unchallenged."
        },
        {
          "pt": "A TelaDoisFatores só troca o layout pelo das telas de acesso; o authenticate(), o limite de tentativas e o código de recuperação são os do Breezy.",
          "en": "TelaDoisFatores only changes layout to match access screens; authenticate(), attempt limit and recovery code come from Breezy."
        }
      ]
    },
    {
      "dot": "amber",
      "title": {
        "pt": "O que não passa pelo desafio",
        "en": "What skips the challenge"
      },
      "items": [
        {
          "pt": "O MustTwoFactor não é reaplicado nos updates Livewire: o desafio é cobrado no GET da página.",
          "en": "MustTwoFactor is not reapplied to Livewire updates: challenge is required on page GET."
        },
        {
          "pt": "O 2FA é cadastrado por painel: o registro do Breezy nasce com o painel corrente e é filtrado por painel.",
          "en": "2FA is set up per panel: Breezy record starts with current panel and is filtered by panel."
        }
      ]
    },
    {
      "dot": "violet",
      "title": {
        "pt": "Com tenant",
        "en": "Tenant on"
      },
      "items": [
        {
          "pt": "No /app, a rota do desafio ganha o prefixo /app/{tenant}, e o MustTwoFactor deixa passar as rotas do /app sem {tenant}, como o logout e a verificação de e-mail.",
          "en": "In /app, challenge route gets /app/{tenant} prefix, and MustTwoFactor allows /app routes without {tenant}, such as logout and email verification."
        }
      ]
    }
  ]
}
