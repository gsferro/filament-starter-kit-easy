  "relationships": [
    {
      "id": "fk_dashboards_tenant_id",
      "from": "dashboards",
      "to": "tenants",
      "fromCardinality": "many",
      "toCardinality": "one",
      "fromOptional": true,
      "toOptional": true,
      "identifying": false,
      "label": "SET NULL",
      "prova": {
        "arquivo": "database/migrations/2026_09_10_100000_add_tenant_id_to_dashboards_table.php",
        "trecho": "$table->foreignId('tenant_id')\n                ->nullable()\n                ->after('page')\n                ->constrained('tenants')\n                ->nullOnDelete();"
      }
    },
    {
      "id": "fk_dashboards_created_by",
      "from": "dashboards",
