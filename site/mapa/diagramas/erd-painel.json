  "cards": [
    {
      "dot": "cyan",
      "title": {
        "pt": "Como ler",
        "en": "Reading"
      },
      "items": [
        {
          "pt": "Colunas e tipos como o SQLite os registra depois de rodar as migrations (PRAGMA table_info). Em MySQL ou PostgreSQL, a mesma migration gera os tipos nativos.",
          "en": "Columns and types as SQLite records them after migrations (PRAGMA table_info). In MySQL or PostgreSQL, the same migration creates native types."
        },
        {
          "pt": "NN = NOT NULL. Sem NN, a coluna aceita nulo.",
          "en": "NN = NOT NULL. Without NN, null is allowed."
        },
        {
          "pt": "PK, FK e UK marcam cada coluna.",
          "en": "PK, FK and UK mark each column."
        },
        {
          "pt": "O rótulo de cada ligação é a regra ON DELETE da chave estrangeira. Linha tracejada: a FK não faz parte da PK da tabela filha.",
          "en": "Each link label is the foreign key's ON DELETE rule. Dashed line: the FK is not part of the child table's PK."
        }
      ]
    },
    {
      "dot": "amber",
      "title": {
        "pt": "Referências sem chave estrangeira",
        "en": "References without foreign keys"
      },
      "items": [
        {
          "pt": "O banco não tem chave estrangeira para estas colunas, por isso elas não ganham linha. Os pares *_type/*_id são relações polimórficas.",
          "en": "Database has no foreign keys for these columns, so they have no lines. *_type/*_id pairs are polymorphic relations."
        },
        {
          "pt": "remember_table_views: user_type/user_id e tenant_id",
          "en": "remember_table_views: user_type/user_id and tenant_id"
        },
        "notifications: notifiable_type/notifiable_id"
      ]
    },
    {
      "dot": "orange",
      "title": {
        "pt": "Outras migrations",
        "en": "Other migrations"
      },
      "items": [
        {
          "pt": "users: aprovacao_pendente (add_aprovacao_pendente_to_users_table), origem (add_origem_to_users_table), ativo e deleted_at (add_ativo_and_soft_deletes_to_users_table), dock_atalhos e dock_layout (add_dock_to_users_table) e aparencia (add_aparencia_to_users_table).",
          "en": "users: aprovacao_pendente (add_aprovacao_pendente_to_users_table), origem (add_origem_to_users_table), ativo and deleted_at (add_ativo_and_soft_deletes_to_users_table), dock_atalhos and dock_layout (add_dock_to_users_table) and aparencia (add_aparencia_to_users_table)."
        },
        {
          "pt": "tenants: cor_primaria e logo (add_identidade_visual_to_tenants_table), registro_habilitado (add_registro_habilitado_to_tenants_table), cor_primaria_nome (add_cor_primaria_nome_to_tenants_table), logo_dark (add_logo_dark_to_tenants_table), unifica_logo (add_unifica_logo_to_tenants_table), aparencia_das_telas (add_aparencia_das_telas_to_tenants_table) e aparencia_por_usuario (add_aparencia_por_usuario_to_tenants_table).",
          "en": "tenants: cor_primaria and logo (add_identidade_visual_to_tenants_table), registro_habilitado (add_registro_habilitado_to_tenants_table), cor_primaria_nome (add_cor_primaria_nome_to_tenants_table), logo_dark (add_logo_dark_to_tenants_table), unifica_logo (add_unifica_logo_to_tenants_table), aparencia_das_telas (add_aparencia_das_telas_to_tenants_table) and aparencia_por_usuario (add_aparencia_por_usuario_to_tenants_table)."
        },
        {
          "pt": "dashboards: template_key (upgrade_dynamic_dashboard_tables_to_v2) e tenant_id (add_tenant_id_to_dashboards_table). A mesma upgrade tira dashboard_grid_id e apaga as tabelas dashboard_grids e dashboard_grid_blocks.",
          "en": "dashboards: template_key (upgrade_dynamic_dashboard_tables_to_v2) and tenant_id (add_tenant_id_to_dashboards_table). Same upgrade removes dashboard_grid_id and drops dashboard_grids and dashboard_grid_blocks tables."
        },
        {
          "pt": "dashboard_widgets: section_slug, x, y, w e h entram, e dashboard_grid_block_id, ordering e columns saem (upgrade_dynamic_dashboard_tables_to_v2).",
          "en": "dashboard_widgets: adds section_slug, x, y, w and h; removes dashboard_grid_block_id, ordering and columns (upgrade_dynamic_dashboard_tables_to_v2)."
        }
      ]
    },
    {
      "dot": "slate",
      "title": {
        "pt": "Evidência",
        "en": "Evidence"
      },
      "items": [
        {
          "pt": "Cada tabela leva à linha da migration que a cria.",
          "en": "Each table links to its creation migration line."
        },
        {
          "pt": "As colunas que outras migrations acrescentam ou tiram estão no card \"Outras migrations\".",
          "en": "Columns added or removed by other migrations are in the \"Other migrations\" card."
        },
        {
          "pt": "Cada ligação leva à linha da chave estrangeira, nos cards \"Prova das ligações\".",
          "en": "Each link leads to the foreign key line in the \"Link evidence\" cards."
        }
      ]
    }
  ]
