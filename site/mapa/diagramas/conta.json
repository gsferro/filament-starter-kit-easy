  "cards": [
    {
      "dot": "cyan",
      "title": {
        "pt": "Como a situação é calculada",
        "en": "How state is computed"
      },
      "items": [
        {
          "pt": "rotuloDaSituacao() devolve Pendente, Inativo ou Ativo, nessa precedência: Pendente vence Inativo.",
          "en": "rotuloDaSituacao() returns Pending, Inactive or Active, in this order: Pending wins over Inactive."
        },
        {
          "pt": "Conta excluída fica fora dessa partição: é o título do aviso que o login mostra para a conta com deleted_at preenchido.",
          "en": "Account deleted is outside this partition: it is the login notice title for accounts with deleted_at set."
        },
        {
          "pt": "Aprovar baixa só aprovacao_pendente: vai a Ativo com ativo = true e a Inativo com ativo = false.",
          "en": "Approve clears only aprovacao_pendente: becomes Active with ativo = true and Inactive with ativo = false."
        },
        {
          "pt": "Restaurar limpa só deleted_at: a conta volta a Pendente com aprovacao_pendente = true; senão, a Ativo com ativo = true, ou a Inativo com ativo = false.",
          "en": "Restore clears only deleted_at: account returns to Pending with aprovacao_pendente = true; else Active with ativo = true, or Inactive with ativo = false."
        }
      ]
    },
    {
      "dot": "emerald",
      "title": {
        "pt": "Onde a conta nasce",
        "en": "Account origins"
      },
      "items": [
        {
          "pt": "Pendente: pelo registro aberto, inclusive pelo login social, com KIT_REGISTRO e KIT_REGISTRO_APROVACAO_MANUAL ligados.",
          "en": "Pending: via open sign-up, including social login, with KIT_REGISTRO and KIT_REGISTRO_APROVACAO_MANUAL on."
        },
        {
          "pt": "Ativo: todas as outras, como as de convite, do /admin e do registro aberto sem aprovação manual; as colunas nascem com ativo = true e aprovacao_pendente = false.",
          "en": "Active: all others, such as invitations, /admin and open sign-up without manual approval; columns start with ativo = true and aprovacao_pendente = false."
        }
      ]
    },
    {
      "dot": "amber",
      "title": {
        "pt": "Quem faz cada transição",
        "en": "Who runs each change"
      },
      "items": [
        {
          "pt": "Aprovar existe no /admin e no /app; Desativar, Reativar e Excluir, só no /admin; Restaurar, no /admin e na Lixeira do /infra.",
          "en": "Approve exists in /admin and /app; Deactivate, Reactivate and Delete only in /admin; Restore in /admin and /infra Trash."
        },
        {
          "pt": "Desativar recusa a própria conta e o último master_global ativo, no model e não só na tela.",
          "en": "Deactivate rejects own account and last Active master_global, in the model as well as the screen."
        },
        {
          "pt": "Aprovar, Desativar e Reativar gravam a coluna no próprio model, com forceFill; Excluir e Restaurar são as ações nativas da tabela, e quem grava deleted_at é o SoftDeletes.",
          "en": "Approve, Deactivate and Reactivate save the column in the model via forceFill; Delete and Restore are native table actions, with SoftDeletes saving deleted_at."
        },
        {
          "pt": "Pendente, Inativo e Conta excluída não entram em painel nenhum: canAccessPanel() nega os três.",
          "en": "Pending, Inactive and Account deleted cannot enter any panel: canAccessPanel() denies all three."
        }
      ]
    },
    {
      "dot": "slate",
      "title": {
        "pt": "Fora do desenho",
        "en": "Outside diagram"
      },
      "items": [
        {
          "pt": "Desativar ou Reativar uma conta pendente muda ativo, mas ela continua Pendente até ser aprovada.",
          "en": "Deactivating or Reactivating a Pending account changes ativo, but it stays Pending until approved."
        },
        {
          "pt": "Na Lixeira do /infra, a conta excluída também pode ser apagada de vez: a linha some, e não há situação para isso.",
          "en": "In /infra Trash, a Deleted account can also be erased for good: the row disappears, with no state for this."
        }
      ]
    }
  ]
}
