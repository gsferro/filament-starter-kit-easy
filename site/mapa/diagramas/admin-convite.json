    {
      "id": "notificar",
      "from": "convite",
      "to": "convitedeacesso",
      "y": 643,
      "label": {
        "pt": "notify: rota mail + token",
        "en": "notify: mail + token"
      },
      "variant": "default",
      "note": {
        "pt": "antes, gera um token de 64 caracteres e grava só o hash sha256, com expira_em = agora + kit.convites.validade_em_dias; depois, loga no canal autenticacao com o e-mail mascarado",
        "en": "first creates a 64-character token and stores only its sha256 hash, with expira_em = now + kit.convites.validade_em_dias; then logs to autenticacao with masked email"
      },
      "prova": {
        "arquivo": "app/Models/Convite.php",
        "trecho": "Notification::route('mail', $this->email)->notify(new ConviteDeAcesso($this, $token));"
      }
    },
    {
      "id": "enfileirar",
      "from": "convitedeacesso",
      "to": "fila",
      "y": 790,
      "label": {
        "pt": "ShouldQueue: vai para a fila",
        "en": "ShouldQueue: queued"
      },
      "variant": "dashed",
      "note": {
        "pt": "QUEUE_CONNECTION=database por padrão: sem worker rodando, o e-mail espera na tabela jobs",
        "en": "QUEUE_CONNECTION=database by default: without a worker, email waits in the jobs table"
      },
      "prova": {
        "arquivo": "app/Notifications/ConviteDeAcesso.php",
        "trecho": "class ConviteDeAcesso extends Notification implements ShouldQueue"
      }
    },
