      "y": 1350,
      "label": {
        "pt": "exclui a linha e loga",
        "en": "deletes row and logs"
      },
      "variant": "security",
      "note": {
        "pt": "o link para de valer na hora; a auditoria registra a exclusão sem o hash do token",
        "en": "link expires at once; audit records deletion without token hash"
      },
      "prova": {
        "arquivo": "app/Filament/Admin/Resources/Convites/Tables/ConvitesTable.php",
        "trecho": "\"[ConvitesTable@revogar] Convite revogado | convite: {$record->id}\","
      }
