      "note": {
        "pt": "link do registro do /app, fora do grupo {tenant}: a organização vem do token, e o aceite acontece lá",
        "en": "/app sign-up link, outside {tenant}: organization comes from token; acceptance takes place there"
      },
      "prova": {
        "arquivo": "app/Notifications/ConviteDeAcesso.php",
        "trecho": "return Filament::getPanel('app')->route('auth.register', ['token' => $this->token]);"
      }
    },
