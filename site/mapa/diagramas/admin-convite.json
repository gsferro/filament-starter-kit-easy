      "y": 551,
      "label": "afterCreate: enviar()",
      "variant": "default",
      "note": {
        "pt": "o envio sai da página, e não de um Observer: seeder, teste e tinker não mandam e-mail",
        "en": "the page sends it, outside an Observer: seeder, tests and tinker send no email"
      },
      "prova": {
        "arquivo": "app/Filament/Admin/Resources/Convites/Pages/CreateConvite.php",
        "trecho": "$convite->enviar();"
      }
