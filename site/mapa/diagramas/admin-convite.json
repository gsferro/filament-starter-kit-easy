  ],
  "cards": [
    {
      "dot": "amber",
      "title": {
        "pt": "Interruptores",
        "en": "Switches"
      },
      "items": [
        {
          "pt": "kit.convites.validade_em_dias (KIT_CONVITE_VALIDADE_DIAS, padrão 7): prazo do link, regravado em expira_em a cada envio",
          "en": "kit.convites.validade_em_dias (KIT_CONVITE_VALIDADE_DIAS, default 7): link lifetime, saved in expira_em on each send"
        },
        {
          "pt": "kit.tenancy.enabled (KIT_TENANCY): mostra o campo Organização no formulário",
          "en": "kit.tenancy.enabled (KIT_TENANCY): shows the Organization field in the form"
        },
        {
          "pt": "kit.email.permitir_mais (KIT_EMAIL_PERMITIR_MAIS, padrão ligado): desligado, o convite recusa e-mail com \"+\" que criaria conta nova, e Reenviar some para ele",
          "en": "kit.email.permitir_mais (KIT_EMAIL_PERMITIR_MAIS, default on): when off, rejects \"+\" email for new accounts and hides Resend for them"
        },
        {
          "pt": "QUEUE_CONNECTION (padrão database): sem worker rodando, o e-mail não sai",
          "en": "QUEUE_CONNECTION (default database): without a worker, email stays queued"
        }
      ]
    },
    {
      "dot": "violet",
      "title": {
        "pt": "Sem e com tenant",
        "en": "Tenant on/off"
      },
      "items": [
        {
          "pt": "Sem tenant: o formulário não mostra Organização e o convite nasce sem tenant_id",
          "en": "Without tenant: form hides Organization and creates invitation without tenant_id"
        },
        {
          "pt": "Com tenant: Organização aparece e é obrigatória para papel do /app; o e-mail cita a organização, e o aceite grava o papel dentro dela",
          "en": "With tenant: Organization is shown and required for /app roles; email names it, and acceptance saves the role within it"
        }
      ]
    },
    {
      "dot": "slate",
      "title": {
        "pt": "Fora deste diagrama",
        "en": "Beyond diagram"
      },
      "items": [
        {
          "pt": "O aceite acontece no /app, pelo link do e-mail (RegistroPorConvite)",
          "en": "Acceptance takes place in /app via the email link (RegistroPorConvite)"
        },
        {
          "pt": "Convidar em massa (ListConvites): o mesmo papel e a mesma organização para até kit.convites.limite_do_lote endereços (100 por padrão)",
          "en": "Bulk invite (ListConvites): same role and organization for up to kit.convites.limite_do_lote addresses (default 100)"
        },
        {
          "pt": "Lembretes: kit:convites-lembrar roda todo dia às 08:00 e manda um segundo link, sem matar o primeiro",
          "en": "Reminders: kit:convites-lembrar runs daily at 08:00 and sends a second link, keeping the first valid"
        }
      ]
    }
  ]
}
