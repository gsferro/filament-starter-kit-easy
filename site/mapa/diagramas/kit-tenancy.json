  "cards": [
    {
      "dot": "amber",
      "title": {
        "pt": "Por que o banco é recriado",
        "en": "Why database is rebuilt"
      },
      "items": [
        {
          "pt": "As tabelas de permissão só nascem com a coluna de tenant se permission.teams estiver ligado antes do migrate.",
          "en": "Permission tables only get tenant column if permission.teams is on before migrate."
        },
        {
          "pt": "Por isso o comando roda migrate:fresh --seed, e não uma migração aditiva: os dados do banco são apagados.",
          "en": "Thus command runs migrate:fresh --seed rather than an additive migration: database data is deleted."
        },
        {
          "pt": "conferirSchema() cobra a coluna model_has_roles.team_id e lança RuntimeException quando ela falta.",
          "en": "conferirSchema() requires model_has_roles.team_id and throws RuntimeException if absent."
        }
      ]
    },
    {
      "dot": "rose",
      "title": {
        "pt": "Como o comando termina",
        "en": "How command ends"
      },
      "items": [
        {
          "pt": "Flag já ligada: SUCCESS, com a sugestão de semear a demo pelo DemoTenancySeeder.",
          "en": "Flag already on: SUCCESS, suggesting demo seeding via DemoTenancySeeder."
        },
        {
          "pt": "Pré-voo: exige git no PATH, um repositório git e a árvore de trabalho limpa.",
          "en": "Preflight: needs git in PATH, a git repo and clean working tree."
        },
        {
          "pt": "Sem --force: sem terminal interativo, ou com a pergunta recusada, sai com FAILURE.",
          "en": "Without --force: no interactive terminal or declined prompt exits with FAILURE."
        },
        {
          "pt": "Qualquer exceção entre ligarFlagNoEnv() e semearDemo() cai no catch: erro no terminal, log no canal tenancy e FAILURE.",
          "en": "Any exception between ligarFlagNoEnv() and semearDemo() enters catch: terminal error, log to tenancy and FAILURE."
        }
      ]
    }
  ]
