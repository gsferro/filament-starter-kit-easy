  "cards": [
    {
      "dot": "amber",
      "title": {
        "pt": "Interruptores",
        "en": "Switches"
      },
      "items": [
        {
          "pt": "lockscreen.enabled (LOCKSCREEN_ENABLED, padrão true): desligado, a sessão não bloqueia e o item Bloquear sessão some.",
          "en": "lockscreen.enabled (LOCKSCREEN_ENABLED, default true): when off, session never locks and Lock session item hides."
        },
        {
          "pt": "lockscreen.idle_timeout (LOCKSCREEN_IDLE_TIMEOUT, padrão 1.800 s): tempo sem navegar até o bloqueio.",
          "en": "lockscreen.idle_timeout (LOCKSCREEN_IDLE_TIMEOUT, default 1,800 s): time without browsing until lock."
        },
        {
          "pt": "O 2FA não é obrigatório: o desafio só aparece para quem confirmou o 2FA no Meu perfil.",
          "en": "2FA is optional: challenge only appears for users who confirmed 2FA in My profile."
        }
      ]
    },
    {
      "dot": "cyan",
      "title": {
        "pt": "Igual nos três painéis",
        "en": "Same in three panels"
      },
      "items": [
        {
          "pt": "/admin, /app e /infra registram o bloqueio e o 2FA com a mesma configuração.",
          "en": "/admin, /app and /infra register session lock and 2FA with same settings."
        },
        {
          "pt": "Desbloquear volta à página que o bloqueio interceptou: quem a guarda é BloquearSessaoComRetorno, no lugar do middleware do pacote.",
          "en": "Unlock returns to page intercepted by lock: BloquearSessaoComRetorno saves it, replacing package middleware."
        }
      ]
    },
    {
      "dot": "rose",
      "title": {
        "pt": "Quando o próprio kit encerra",
        "en": "When kit ends session"
      },
      "items": [
        {
          "pt": "Sem painel acessível: a escolha de painel da página única de login encerra a sessão de quem não alcança painel nenhum; a resposta do cadastro faz o mesmo.",
          "en": "No accessible panel: unified login page panel choice ends session for users with no panel access; sign-up response does the same."
        },
        {
          "pt": "Link de senha enviado: o Meu perfil encerra a sessão depois de mandar o link de definição de senha, para a pessoa entrar de novo com a senha nova.",
          "en": "Password link sent: My profile ends session after sending password setup link, so user signs in again with new password."
        },
        {
          "pt": "Cadastro pendente: o cadastro que nasce pendente de aprovação encerra a sessão logo depois de criar a conta.",
          "en": "Pending sign-up: sign-up Pending approval ends session right after creating account."
        }
      ]
    },
    {
      "dot": "slate",
      "title": {
        "pt": "Fora do desenho",
        "en": "Outside diagram"
      },
      "items": [
        {
          "pt": "Sair, Trocar de conta (na tela de bloqueio) e cancelar o desafio de 2FA encerram a sessão no código dos pacotes; nenhuma linha do kit os dispara.",
          "en": "Sign out, Switch account (on lock screen) and cancel 2FA challenge end session in package code; no kit line triggers them."
        },
        {
          "pt": "Todo fim de sessão fica em authentication_log.logout_at: o kit liga o evento Logout ao listener do authentication-log.",
          "en": "Every session end is in authentication_log.logout_at: kit wires Logout event to authentication-log listener."
        }
      ]
    }
  ]
