{
    "name": "starter-kit",
    "networks": {
        "default": {
            "name": "starter-kit_default",
            "ipam": {}
        }
    },
    "services": {
        "app": {
            "profiles": [
                "app"
            ],
            "build": {
                "context": "<raiz>",
                "dockerfile": "Dockerfile.laravel",
                "target": "app"
            },
            "command": [
                "sh",
                "-c",
                "php artisan view:cache &&\n       php-fpm"
            ],
            "depends_on": {
                "mysql": {
                    "condition": "service_healthy",
                    "required": false
                },
                "pgsql": {
                    "condition": "service_healthy",
                    "required": true
                },
                "redis": {
                    "condition": "service_healthy",
                    "required": true
                }
            },
            "entrypoint": null,
            "environment": {
                "COMPOSE_PROJECT_NAME": "starter-kit",
                "DB_CONNECTION": "pgsql",
                "DB_HOST": "pgsql",
                "LLAMACPP_EMBED_URL": "http://llamacpp-embeddings:8080/v1",
                "LLAMACPP_URL": "http://llamacpp:8080/v1",
                "REDIS_HOST": "redis",
                "REVERB_HOST": "reverb",
                "REVERB_PORT": "8090",
                "VITE_REVERB_HOST": "localhost",
                "VITE_REVERB_PORT": "8090"
            },
            "healthcheck": {
                "test": [
                    "CMD-SHELL",
                    "pgrep php-fpm || exit 1"
                ],
                "timeout": "5s",
                "interval": "15s",
                "retries": 5,
                "start_period": "1m30s"
            },
            "networks": {
                "default": null
            },
            "restart": "unless-stopped",
            "user": "www-data",
            "volumes": [
                {
                    "type": "bind",
                    "source": "<raiz>/.env",
                    "target": "/var/www/.env",
                    "bind": {}
                },
                {
                    "type": "volume",
                    "source": "app-storage",
                    "target": "/var/www/storage",
                    "volume": {}
                }
            ]
        },
        "llamacpp": {
            "profiles": [
                "ai",
                "full"
            ],
            "command": [
                "-hf",
                "bartowski/Qwen2.5-7B-Instruct-GGUF:Q4_K_M",
                "--alias",
                "qwen2.5-7b-instruct",
                "--host",
                "0.0.0.0",
                "--port",
                "8080",
                "--ctx-size",
                "8192",
                "--parallel",
                "2",
                "--cache-reuse",
                "256"
            ],
            "deploy": {
                "resources": {
                    "limits": {
                        "memory": "8589934592"
                    }
                },
                "placement": {}
            },
            "entrypoint": null,
            "healthcheck": {
                "test": [
                    "CMD",
                    "curl",
                    "-f",
                    "http://localhost:8080/health"
                ],
                "timeout": "5s",
                "interval": "15s",
                "retries": 40,
                "start_period": "5m0s"
            },
            "image": "ghcr.io/ggml-org/llama.cpp:server-b9967",
            "networks": {
                "default": null
            },
            "ports": [
                {
                    "mode": "ingress",
                    "target": 8080,
                    "published": "8080",
                    "protocol": "tcp"
                }
            ],
            "restart": "unless-stopped",
            "volumes": [
                {
                    "type": "volume",
                    "source": "llamacpp-cache",
                    "target": "/root/.cache/llama.cpp",
                    "volume": {}
                }
            ]
        },
        "llamacpp-embeddings": {
            "profiles": [
                "ai",
                "full"
            ],
            "command": [
                "-hf",
                "Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0",
                "--alias",
                "qwen3-embedding-0.6b",
                "--embeddings",
                "--pooling",
                "last",
                "--host",
                "0.0.0.0",
                "--port",
                "8080",
                "--ctx-size",
                "8192",
                "--ubatch-size",
                "8192"
            ],
            "deploy": {
                "resources": {
                    "limits": {
                        "memory": "2147483648"
                    }
                },
                "placement": {}
            },
            "entrypoint": null,
            "healthcheck": {
                "test": [
                    "CMD",
                    "curl",
                    "-f",
                    "http://localhost:8080/health"
                ],
                "timeout": "5s",
                "interval": "15s",
                "retries": 40,
                "start_period": "2m0s"
            },
            "image": "ghcr.io/ggml-org/llama.cpp:server-b9967",
            "networks": {
                "default": null
            },
            "ports": [
                {
                    "mode": "ingress",
                    "target": 8080,
                    "published": "8081",
                    "protocol": "tcp"
                }
            ],
            "restart": "unless-stopped",
            "volumes": [
                {
                    "type": "volume",
                    "source": "llamacpp-cache",
                    "target": "/root/.cache/llama.cpp",
                    "volume": {}
                }
            ]
        },
        "mailpit": {
            "profiles": [
                "mail",
                "full"
            ],
            "command": null,
            "entrypoint": null,
            "image": "axllent/mailpit:v1.27",
            "networks": {
                "default": null
            },
            "ports": [
                {
                    "mode": "ingress",
                    "target": 1025,
                    "published": "1025",
                    "protocol": "tcp"
                },
                {
                    "mode": "ingress",
                    "target": 8025,
                    "published": "8025",
                    "protocol": "tcp"
                }
            ],
            "restart": "unless-stopped"
        },
        "mysql": {
            "profiles": [
                "mysql"
            ],
            "command": null,
            "entrypoint": null,
            "environment": {
                "MYSQL_DATABASE": "starter_kit",
                "MYSQL_ROOT_PASSWORD": ""
            },
            "healthcheck": {
                "test": [
                    "CMD-SHELL",
                    "mysqladmin ping -h localhost -u root -p\"$$MYSQL_ROOT_PASSWORD\" --silent"
                ],
                "timeout": "5s",
                "interval": "10s",
                "retries": 5
            },
            "image": "mysql:8.0",
            "networks": {
                "default": null
            },
            "ports": [
                {
                    "mode": "ingress",
                    "target": 3306,
                    "published": "3306",
                    "protocol": "tcp"
                }
            ],
            "restart": "unless-stopped",
            "volumes": [
                {
                    "type": "volume",
                    "source": "mysql-data",
                    "target": "/var/lib/mysql",
                    "volume": {}
                }
            ]
        },
        "nginx": {
            "profiles": [
                "app"
            ],
            "build": {
                "context": "<raiz>",
                "dockerfile": "Dockerfile.laravel",
                "target": "web"
            },
            "command": [
                "sh",
                "-c",
                "chown -R 82:82 /var/www/storage &&\n       ln -sf /var/www/storage/app/public /var/www/public/storage &&\n       nginx -g 'daemon off;'"
            ],
            "depends_on": {
                "app": {
                    "condition": "service_healthy",
                    "required": true
                }
            },
            "entrypoint": null,
            "healthcheck": {
                "test": [
                    "CMD-SHELL",
                    "wget -q -O /dev/null http://127.0.0.1/up"
                ],
                "timeout": "5s",
                "interval": "15s",
                "retries": 10
            },
            "networks": {
                "default": null
            },
            "ports": [
                {
                    "mode": "ingress",
                    "target": 80,
                    "published": "8000",
                    "protocol": "tcp"
                }
            ],
            "restart": "unless-stopped",
            "volumes": [
                {
                    "type": "bind",
                    "source": "<raiz>/.env",
                    "target": "/var/www/.env",
                    "bind": {}
                },
                {
                    "type": "volume",
                    "source": "app-storage",
                    "target": "/var/www/storage",
                    "volume": {}
                }
            ]
        },
        "pgsql": {
            "command": null,
            "entrypoint": null,
            "environment": {
                "POSTGRES_DB": "starter_kit",
                "POSTGRES_PASSWORD": "secret",
                "POSTGRES_USER": "starter_kit"
            },
            "healthcheck": {
                "test": [
                    "CMD-SHELL",
                    "pg_isready -q -d starter_kit -U starter_kit"
                ],
                "timeout": "5s",
                "interval": "10s",
                "retries": 5
            },
            "image": "pgvector/pgvector:pg17",
            "networks": {
                "default": null
            },
            "ports": [
                {
                    "mode": "ingress",
                    "target": 5432,
                    "published": "5432",
                    "protocol": "tcp"
                }
            ],
            "restart": "unless-stopped",
            "volumes": [
                {
                    "type": "volume",
                    "source": "pgsql-data",
                    "target": "/var/lib/postgresql/data",
                    "volume": {}
                },
                {
                    "type": "bind",
                    "source": "<raiz>/docker/pgsql/init",
                    "target": "/docker-entrypoint-initdb.d",
                    "bind": {}
                }
            ]
        },
        "pulse": {
            "profiles": [
                "app",
                "realtime"
            ],
            "build": {
                "context": "<raiz>",
                "dockerfile": "Dockerfile.laravel",
                "target": "app"
            },
            "command": [
                "php",
                "/var/www/artisan",
                "pulse:check"
            ],
            "depends_on": {
                "app": {
                    "condition": "service_started",
                    "required": false
                },
                "mysql": {
                    "condition": "service_healthy",
                    "required": false
                },
                "pgsql": {
                    "condition": "service_healthy",
                    "required": true
                }
            },
            "entrypoint": null,
            "environment": {
                "COMPOSE_PROJECT_NAME": "starter-kit",
                "DB_CONNECTION": "pgsql",
                "DB_HOST": "pgsql",
                "REDIS_HOST": "redis"
            },
            "networks": {
                "default": null
            },
            "restart": "unless-stopped",
            "user": "www-data",
            "volumes": [
                {
                    "type": "bind",
                    "source": "<raiz>/.env",
                    "target": "/var/www/.env",
                    "bind": {}
                },
                {
                    "type": "volume",
                    "source": "app-storage",
                    "target": "/var/www/storage",
                    "volume": {}
                }
            ]
        },
        "queue": {
            "profiles": [
                "app"
            ],
            "build": {
                "context": "<raiz>",
                "dockerfile": "Dockerfile.laravel",
                "target": "app"
            },
            "command": [
                "php",
                "/var/www/artisan",
                "queue:work",
                "--queue=ai,ai-post,default",
                "--tries=3",
                "--timeout=600",
                "--max-time=3600"
            ],
            "depends_on": {
                "app": {
                    "condition": "service_started",
                    "required": true
                },
                "mysql": {
                    "condition": "service_healthy",
                    "required": false
                },
                "pgsql": {
                    "condition": "service_healthy",
                    "required": true
                },
                "redis": {
                    "condition": "service_healthy",
                    "required": true
                }
            },
            "entrypoint": null,
            "environment": {
                "COMPOSE_PROJECT_NAME": "starter-kit",
                "DB_CONNECTION": "pgsql",
                "DB_HOST": "pgsql",
                "LLAMACPP_EMBED_URL": "http://llamacpp-embeddings:8080/v1",
                "LLAMACPP_URL": "http://llamacpp:8080/v1",
                "REDIS_HOST": "redis"
            },
            "networks": {
                "default": null
            },
            "restart": "unless-stopped",
            "user": "www-data",
            "volumes": [
                {
                    "type": "bind",
                    "source": "<raiz>/.env",
                    "target": "/var/www/.env",
                    "bind": {}
                },
                {
                    "type": "volume",
                    "source": "app-storage",
                    "target": "/var/www/storage",
                    "volume": {}
                }
            ]
        },
        "redis": {
            "command": [
                "redis-server",
                "--maxmemory",
                "256mb",
                "--maxmemory-policy",
                "allkeys-lru",
                "--appendonly",
                "no"
            ],
            "entrypoint": null,
            "healthcheck": {
                "test": [
                    "CMD",
                    "redis-cli",
                    "ping"
                ],
                "timeout": "5s",
                "interval": "10s",
                "retries": 5
            },
            "image": "redis:7-alpine",
            "networks": {
                "default": null
            },
            "ports": [
                {
                    "mode": "ingress",
                    "target": 6379,
                    "published": "6379",
                    "protocol": "tcp"
                }
            ],
            "restart": "unless-stopped",
            "volumes": [
                {
                    "type": "volume",
                    "source": "redis-data",
                    "target": "/data",
                    "volume": {}
                }
            ]
        },
        "reverb": {
            "profiles": [
                "app",
                "realtime"
            ],
            "build": {
                "context": "<raiz>",
                "dockerfile": "Dockerfile.laravel",
                "target": "app"
            },
            "command": [
                "php",
                "/var/www/artisan",
                "reverb:start"
            ],
            "depends_on": {
                "app": {
                    "condition": "service_started",
                    "required": false
                },
                "mysql": {
                    "condition": "service_healthy",
                    "required": false
                },
                "pgsql": {
                    "condition": "service_healthy",
                    "required": true
                }
            },
            "entrypoint": null,
            "environment": {
                "COMPOSE_PROJECT_NAME": "starter-kit",
                "DB_CONNECTION": "pgsql",
                "DB_HOST": "pgsql",
                "REDIS_HOST": "redis"
            },
            "networks": {
                "default": null
            },
            "ports": [
                {
                    "mode": "ingress",
                    "target": 8090,
                    "published": "8090",
                    "protocol": "tcp"
                }
            ],
            "restart": "unless-stopped",
            "user": "www-data",
            "volumes": [
                {
                    "type": "bind",
                    "source": "<raiz>/.env",
                    "target": "/var/www/.env",
                    "bind": {}
                },
                {
                    "type": "volume",
                    "source": "app-storage",
                    "target": "/var/www/storage",
                    "volume": {}
                }
            ]
        },
        "scheduler": {
            "profiles": [
                "app"
            ],
            "build": {
                "context": "<raiz>",
                "dockerfile": "Dockerfile.laravel",
                "target": "app"
            },
            "command": [
                "php",
                "/var/www/artisan",
                "schedule:work"
            ],
            "depends_on": {
                "app": {
                    "condition": "service_started",
                    "required": true
                },
                "mysql": {
                    "condition": "service_healthy",
                    "required": false
                },
                "pgsql": {
                    "condition": "service_healthy",
                    "required": true
                },
                "redis": {
                    "condition": "service_healthy",
                    "required": true
                }
            },
            "entrypoint": null,
            "environment": {
                "COMPOSE_PROJECT_NAME": "starter-kit",
                "DB_CONNECTION": "pgsql",
                "DB_HOST": "pgsql",
                "REDIS_HOST": "redis"
            },
            "networks": {
                "default": null
            },
            "restart": "unless-stopped",
            "user": "www-data",
            "volumes": [
                {
                    "type": "bind",
                    "source": "<raiz>/.env",
                    "target": "/var/www/.env",
                    "bind": {}
                },
                {
                    "type": "volume",
                    "source": "app-storage",
                    "target": "/var/www/storage",
                    "volume": {}
                }
            ]
        }
    },
    "volumes": {
        "app-storage": {
            "name": "starter-kit_app-storage"
        },
        "llamacpp-cache": {
            "name": "starter-kit_llamacpp-cache"
        },
        "mysql-data": {
            "name": "starter-kit_mysql-data"
        },
        "pgsql-data": {
            "name": "starter-kit_pgsql-data"
        },
        "redis-data": {
            "name": "starter-kit_redis-data"
        }
    }
}
