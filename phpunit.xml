<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
            Testes do kit, isolados da suíte do seu negócio: rode com
            `composer test:kit`. Cobrem a fundação (painéis, telas de infra e
            admin, uuid, gates, camada de IA) e são o que se roda depois de um
            kit:update, para saber se a atualização quebrou algo.
        -->
        <testsuite name="Tenancy">
            <directory>tests/Tenancy</directory>
        </testsuite>
        <testsuite name="Kit">
            <directory>tests/Kit</directory>
        </testsuite>
        <!--
            Telas em navegador real (pest-plugin-browser). Fora do
            `composer test:kit` porque browser em série custa ordens de
            magnitude mais que HTTP: rode com `composer test:browser`, que
            já embute o `npm run build` de que a suíte depende.
        -->
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
            <!--
                Multi-tenancy tem pasta própria porque o TenancyTestCase fixa
                `permission.teams` antes das migrations, e o Pest não permite
                dois TestCases na mesma pasta.
            -->
            <directory>tests/BrowserTenancy</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            A suíte roda contra a configuração DO KIT, não contra a do projeto.

            Sem isto, quem personaliza vê vermelho sem ter quebrado nada: um projeto
            que escolheu a cor Violet e chamou a organização de "Universidade" fazia
            cinco casos falharem — a URL do cadastro vira /admin/universidades, o
            /admin nasce violeta em vez do âmbar padrão, e o plural sugerido deixa de
            ser "Organizações". Nenhum é regressão, e é justamente isso que torna o
            estrago grave: o `composer test:kit` existe para dizer se a FUNDAÇÃO
            continua íntegra depois de um kit:update, e um vermelho por diferença de
            config não deixa ninguém distinguir uma coisa da outra.

            Fixar aqui vale para toda a suíte de uma vez, e é o mesmo motivo pelo
            qual banco, fila e e-mail já estão fixados abaixo.
        -->
        <env name="KIT_COR_PRIMARIA" value="" force="true"/>
        <env name="KIT_DEMO" value="false" force="true"/>
        <env name="KIT_HUB" value="false" force="true"/>
        <env name="KIT_TENANCY_LABEL" value="Organização" force="true"/>
        <env name="KIT_TENANCY_LABEL_PLURAL" value="Organizações" force="true"/>
        <env name="KIT_TENANCY_SLUG" value="organizacoes" force="true"/>
        <!--
            Provedores sociais precisam nascer desligados e sem credenciais nos testes.
            Senão, um .env com GOOGLE_CLIENT_ID real faz o teste `disponivel()`
            devolver true no início e falhar a asserção de "desligado por padrão".
            Cada caso de teste liga explicitamente o que precisa.
        -->
        <env name="KIT_SOCIALITE_GOOGLE" value="false" force="true"/>
        <env name="GOOGLE_CLIENT_ID" value="" force="true"/>
        <env name="GOOGLE_CLIENT_SECRET" value="" force="true"/>
        <env name="KIT_SOCIALITE_GITHUB" value="false" force="true"/>
        <env name="GITHUB_CLIENT_ID" value="" force="true"/>
        <env name="GITHUB_CLIENT_SECRET" value="" force="true"/>
        <env name="KIT_SOCIALITE_LINKEDIN" value="false" force="true"/>
        <env name="LINKEDIN_CLIENT_ID" value="" force="true"/>
        <env name="LINKEDIN_CLIENT_SECRET" value="" force="true"/>
        <env name="KIT_SOCIALITE_X" value="false" force="true"/>
        <env name="X_CLIENT_ID" value="" force="true"/>
        <env name="X_CLIENT_SECRET" value="" force="true"/>
        <env name="KIT_SOCIALITE_VINCULO_CONFIRMAR" value="false" force="true"/>
        <!--
            O resto das chaves do kit, cada uma no DEFAULT do config/kit.php — pelo
            mesmo motivo do bloco de cima: um .env local com KIT_REGISTRO=true ou
            KIT_ANTI_ROBO=true faria a suíte medir o projeto, não o kit. Quem quer
            outro valor liga no próprio caso (`config()->set()` ou `kitConfigCom()`).
        -->
        <env name="KIT_REGISTRO" value="false" force="true"/>
        <env name="KIT_REGISTRO_APROVACAO_MANUAL" value="false" force="true"/>
        <env name="KIT_REGISTRO_VERIFICAR_EMAIL" value="false" force="true"/>
        <env name="KIT_TABELA_PAGINACAO" value="10" force="true"/>
        <env name="KIT_TABELA_LISTRADA" value="true" force="true"/>
        <env name="KIT_TABELA_PERSISTIR_FILTROS" value="true" force="true"/>
        <env name="KIT_TABELA_COLUNAS_REDIMENSIONAVEIS" value="true" force="true"/>
        <env name="KIT_COR_PRIMARIA_HEX" value="" force="true"/>
        <env name="KIT_LOGIN_RODAPE" value="" force="true"/>
        <env name="KIT_ANTI_ROBO" value="false" force="true"/>
        <env name="KIT_ANTI_ROBO_LOCAL" value="false" force="true"/>
        <env name="KIT_ANTI_ROBO_PROVEDOR" value="recaptcha_v2" force="true"/>
        <env name="KIT_ANTI_ROBO_CHAVE_DO_SITE" value="" force="true"/>
        <env name="KIT_ANTI_ROBO_CHAVE_SECRETA" value="" force="true"/>
        <env name="KIT_ANTI_ROBO_PONTUACAO_MINIMA" value="0.5" force="true"/>
        <env name="KIT_CONVITE_VALIDADE_DIAS" value="7" force="true"/>
        <env name="KIT_CONVITE_LIMITE_LOTE" value="100" force="true"/>
        <env name="KIT_CONVITE_LEMBRETES_DIAS" value="3,5" force="true"/>
        <env name="KIT_RETENCAO_EXCECOES_DIAS" value="14" force="true"/>
        <env name="KIT_RETENCAO_EMAILS_DIAS" value="14" force="true"/>
        <env name="KIT_RETENCAO_IMPORTACOES_DIAS" value="30" force="true"/>
        <env name="KIT_RETENCAO_EXPORTACOES_DIAS" value="30" force="true"/>

        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <!--
            DT-10: sem estas duas a suíte escreve no storage/logs real.

            A segunda é a que importa: os canais do kit são Log::channel() nomeado, e
            LOG_CHANNEL só troca o default. E o valor é `monolog`, NÃO `null` — não existe
            driver `null` no LogManager, e o env() do Laravel converteria a string "null" em
            null de verdade, caindo no emergency logger (= storage/logs/laravel.log). O
            porquê completo está no comentário de config/logging.php.
        -->
        <env name="LOG_CHANNEL" value="null"/>
        <env name="LOG_KIT_DRIVER" value="monolog" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!--
            O notifier de releases enfileira um sync no evento de Login, e com
            QUEUE_CONNECTION=sync isso vira uma chamada HTTP ao repo.packagist.org
            DENTRO do teste: ~7s no primeiro login de cada teste que autentica de
            verdade (formulário, aceite de convite, destravar sessão). No CI a
            latência estourava a espera do `assertPathIs('/app')` e derrubava o
            login pela tela em tests/Browser/PerfisTest.php.
        -->
        <env name="FILAMENT_COMPOSER_RELEASE_NOTIFIER_ENABLED" value="false" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
